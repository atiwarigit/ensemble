# Postgres. Local dev: postgres://ensemble:ensemble@localhost:5432/ensemble
# Production: Neon pooled URL (injected by the Vercel Marketplace integration).
DATABASE_URL=postgres://ensemble:ensemble@localhost:5432/ensemble
# Direct (non-pooled) URL used by migrations. Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=
# Separate database used by `pnpm test`.
TEST_DATABASE_URL=postgres://ensemble:ensemble@localhost:5432/ensemble_test

# 32+ random bytes: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Seed (scripts/seed.ts)
BOOTSTRAP_OWNER_EMAIL=romel@ensemble.local
BOOTSTRAP_OWNER_NAME=Romel
SEED_MEMBER_EMAIL=nikki@ensemble.local
SEED_MEMBER_NAME=Nikki
# Initial password for seeded users. Required in production; dev default is used when empty.
SEED_PASSWORD=

# Owners and admins must enrol TOTP 2FA before using the app. Set to "false" only for local debugging.
REQUIRE_2FA_FOR_ADMINS=true

# Optional: invite emails. Without these, admins copy invite links by hand.
RESEND_API_KEY=
EMAIL_FROM=
