# Postgres. Local dev: postgres://ensemble:ensemble@localhost:5432/ensemble
# Production: Neon pooled URL (injected by the Vercel Marketplace integration).
DATABASE_URL=postgres://ensemble:ensemble@localhost:5432/ensemble
# Direct (non-pooled) URL used by migrations. Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=
# Separate database used by `pnpm test`.
TEST_DATABASE_URL=postgres://ensemble:ensemble@localhost:5432/ensemble_test

# 32+ random bytes: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Seed (scripts/seed.ts)
BOOTSTRAP_OWNER_EMAIL=romel@ensemble.local
BOOTSTRAP_OWNER_NAME=Romel
SEED_MEMBER_EMAIL=nikki@ensemble.local
SEED_MEMBER_NAME=Nikki
# Initial password for seeded users. Required in production; dev default is used when empty.
SEED_PASSWORD=

# Owners and admins must enrol TOTP 2FA before using the app. Set to "false" only for local debugging.
REQUIRE_2FA_FOR_ADMINS=true

# Optional: AI assistant. Both providers are optional; with neither key, chat answers with slash commands.
# With both, the workspace's choice (Settings → AI assistant) is primary and the other is a one-shot fallback on 429/5xx.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Force a provider for every workspace: anthropic | openai | none (commands only). Leave empty to let owners choose.
LLM_PROVIDER=
# Default monthly cap (estimated USD) per workspace; owners can lower it, raising it needs an approval.
LLM_MONTHLY_BUDGET_USD=25
# Tests and demos only: point the SDKs at tests/mocks/llm-server.mjs.
# ANTHROPIC_BASE_URL=http://localhost:4010/anthropic/v1
# OPENAI_BASE_URL=http://localhost:4010/openai/v1

# Optional: invite emails. Without these, admins copy invite links by hand.
RESEND_API_KEY=
EMAIL_FROM=
